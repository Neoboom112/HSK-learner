# Copy this file to .env and fill in your own values.

# --- Telegram -------------------------------------------------------------
# Token issued by @BotFather. Required.
BOT_TOKEN=
# Comma separated Telegram ids allowed to use /admin.
ADMIN_IDS=

# --- Localisation ---------------------------------------------------------
# Locale used before the user picks one: en | ru | zh
DEFAULT_LOCALE=en

# --- Storage --------------------------------------------------------------
# Paths are resolved against the project directory when relative.
DATA_DIR=data
BACKUP_DIR=backups
# Leave empty to use sqlite+aiosqlite:///<DATA_DIR>/bot.db
DATABASE_URL=
# Optional explicit database file (empty = <DATA_DIR>/bot.db). Useful when the
# project folder is on a drive that antivirus or sync tools keep locking.
DB_FILE=
# Log every SQL statement (true/false).
SQL_ECHO=false

# --- Behaviour ------------------------------------------------------------
# Largest accepted dictionary upload. Telegram caps bot downloads at 20 MB.
MAX_UPLOAD_MB=20
DAILY_REVIEW_LIMIT=20
REVIEW_CHECK_SECONDS=300
# Automatic "time to review" messages. Off by default.
REVIEW_REMINDERS=false
BACKUP_INTERVAL_HOURS=24
THROTTLE_INTERVAL=0.4
LOG_LEVEL=INFO
